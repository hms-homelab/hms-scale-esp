# Settings shared by every supported chip. The target itself is NOT set here:
# it comes from `idf.py set-target <chip>`, and ESP-IDF then layers the matching
# sdkconfig.defaults.<target> on top of this file. Anything chip-specific
# (console routing, above all) belongs in that file, not this one.
#
# Supported targets: esp32c3 (Super Mini, the original board), esp32s3.

# Bluetooth Configuration
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y

# HTTP Client (no HTTPS needed for local webhook)
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Serial flasher config
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Phone browsers send header sets well past the 512-byte default, which makes
# esp_http_server answer 431 "Header fields are too long" — on the captive
# portal too, where it would block onboarding. hms-esp-apc already uses 2048.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
